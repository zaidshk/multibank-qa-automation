# ─── Target Environment ───────────────────────────────────────────────────────
# Accepted values: dev | qa | preprod | prod   Default: qa
ENV=qa

# ─── BrowserStack ─────────────────────────────────────────────────────────────
# Set USE_BROWSERSTACK=true to route all test runs through BrowserStack Automate.
# Credentials are injected from CI secrets; never commit real values here.
USE_BROWSERSTACK=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BS_PROJECT_NAME=MB QA Automation
BS_BUILD_NAME=

# ─── SMTP Report Emailing ─────────────────────────────────────────────────────
# Used by scripts/send-report.ts on CI test failure.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated list of recipient email addresses
REPORT_EMAIL_TO=
